{"arquivo": "subtitle/subtitle0651_us.dat", "membro": "subtitle0651.smd", "id": "M1090_S0205_H0010_001_a9s", "antes_sha1": "b603d72acde7", "texto": "Que bom... que eu... acertei em cheio..."}
{"arquivo": "subtitle/subtitle0651_us.dat", "membro": "subtitle0651.smd", "id": "M1090_S0205_H0030_001_eve", "antes_sha1": "a255b7aeda1e", "texto": "Vocês vão morrer... Todos vocês vão MORRER!"}
{"arquivo": "subtitle/subtitle0660_us.dat", "membro": "subtitle0660.smd", "id": "M1090_S0250_H0020_001_eve", "antes_sha1": "b9c46eebbecd", "texto": "Que este mundo... não tem sentido algum."}
{"arquivo": "subtitle/subtitle0661_us.dat", "membro": "subtitle0661.smd", "id": "M1090_S0250_H0020_001_eve", "antes_sha1": "b9c46eebbecd", "texto": "Que este mundo... não tem sentido algum."}
{"arquivo": "subtitle/subtitle0693_us.dat", "membro": "subtitle0693.smd", "id": "M1090_S2000_H0070_001_a2b", "antes_sha1": "5d7c8bc49501", "texto": "As transmissões de dados... estão ressoando entre si..."}
