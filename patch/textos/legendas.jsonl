{"arquivo": "subtitle/subtitle0571_us.dat", "membro": "subtitle0571.smd", "id": "M1080_S0060_H0170_101_prsts", "antes_sha1": "8efbc9009d7e", "texto": "Morreremos todos juntos e nos tornaremos deuses!"}
{"arquivo": "subtitle/subtitle0590_us.dat", "membro": "subtitle0590.smd", "id": "M1080_S0085_H0040_201_a9s", "antes_sha1": "e399c2c4b110", "texto": "Assim, nossas almas serão salvas."}
{"arquivo": "subtitle/subtitle0600_us.dat", "membro": "subtitle0600.smd", "id": "M1080_S0850_H0010_201_cmd", "antes_sha1": "76f7497a1711", "texto": "E precisamos de um deus pelo qual valha a pena morrer."}
{"arquivo": "subtitle/subtitle0642_us.dat", "membro": "subtitle0642.smd", "id": "M1090_S1500_H0020_101_a9s", "antes_sha1": "b603d72acde7", "texto": "Que bom... que eu... acertei em cheio..."}
