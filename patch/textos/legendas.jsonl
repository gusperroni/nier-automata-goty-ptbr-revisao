{"arquivo": "subtitle/subtitle0693_us.dat", "membro": "subtitle0693.smd", "id": "M1090_S2000_H0140_001_a9s", "antes_sha1": "172e526a39e4", "texto": "plexei tudo nas memórias de alguns inimigos próximos, para que, quando eu voltasse ao meu corpo, eu..."}
