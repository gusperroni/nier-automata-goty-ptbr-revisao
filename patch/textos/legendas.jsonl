{"arquivo": "subtitle/subtitle0650_us.dat", "membro": "subtitle0650.smd", "id": "M1090_S0205_H0010_001_a9s", "antes_sha1": "b603d72acde7", "texto": "Que bom... que eu... acertei em cheio..."}
